{
  "name": "friction2tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Turn a small everyday friction into a tiny, usable single-file web tool.",
  "license": "MIT",
  "author": "Friction2Tool contributors",
  "homepage": "https://lzx633-cloud-all.github.io/friction2tool/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzx633-cloud-all/friction2tool.git"
  },
  "bugs": {
    "url": "https://github.com/lzx633-cloud-all/friction2tool/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "react",
    "vite",
    "typescript",
    "openai",
